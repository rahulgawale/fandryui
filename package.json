{
  "name": "fandryui",
  "version": "0.15.1",
  "description": "Lightning Web Components (LWC) UI library optimized for longevity, clarity, and discipline",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/rahulgawale/fandryui.git"
  },
  "scripts": {
    "clean:all": "rimraf node_modules __lwr_cache__ site",
    "clean": "rimraf __lwr_cache__ site",
    "dev": "lwr dev",
    "dev:compat": "lwr dev --mode compat",
    "build": "lwr build --clean",
    "build:prod-compat": "lwr build --clean --mode prod-compat",
    "start": "lwr start",
    "stage": "npm run build && npm start",
    "stage:prod-compat": "npm run build:prod-compat && npm start",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d site --nojekyll --cname fandryui.forcetrails.com",
    "lint": "echo 'Lint check placeholder'",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "build:npm": "node scripts/build-dist.mjs",
    "verify:npm": "node scripts/verify-npm.mjs",
    "verify:sfdx": "node scripts/verify-sfdx.mjs",
    "example:sfdx": "cd examples/salesforce && node ../../packages/ui/dist/bin/fandry.mjs init && node ../../packages/ui/dist/bin/fandry.mjs add button input table"
  },
  "dependencies": {
    "@tanstack/table-core": "^8.21.3",
    "lwc": "latest",
    "lwr": "0.18.3",
    "qs": "^6.14.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-syntax-decorators": "^7.29.7",
    "@babel/plugin-transform-typescript": "^7.29.9",
    "@lwc/jest-preset": "^19.6.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.3",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/jest": "^29.5.14",
    "esbuild": "^0.28.2",
    "gh-pages": "^6.2.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "semantic-release": "^25.0.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": "20.13.1"
  },
  "volta": {
    "node": "20.16.0"
  }
}
