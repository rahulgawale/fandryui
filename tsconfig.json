{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": false,
    "useDefineForClassFields": false,
    "baseUrl": ".",
    "paths": {
      // Exact entries take precedence over the wildcard below and are
      // needed for any fd/* module that's imported directly by another
      // component's .ts file (not just referenced as an HTML tag, which
      // LWC's own template compiler resolves separately) -- the wildcard
      // can't express the namespace/name/name.ts folder convention with a
      // single `*` substitution (TS paths only allow one `*` per pattern).
      "fd/tableState": ["src/core/fd/tableState/tableState"],
      "fd/*": ["src/core/fd/*"],
      "fandryui/*": ["src/modules/fandryui/*"]
    },
    "typeRoots": ["./node_modules/@types", "./src/types"]
  },
  "include": ["src/**/*", "src/types/**/*", "src/types"],
  "exclude": ["node_modules", "__lwr_cache__", "site"]
}
