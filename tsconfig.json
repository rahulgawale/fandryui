{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": false,
    "useDefineForClassFields": false,
    "baseUrl": ".",
    "paths": {
      // Exact entries take precedence over the wildcard below and are
      // needed for any fandry/* module that's imported directly by another
      // component's .ts file (not just referenced as an HTML tag, which
      // LWC's own template compiler resolves separately) -- the wildcard
      // can't express the namespace/name/name.ts folder convention with a
      // single `*` substitution (TS paths only allow one `*` per pattern).
      "fandry/base": ["src/core/fandry/base/base"],
      "fandry/tableState": ["src/core/fandry/tableState/tableState"],
      "fandry/*": ["src/core/fandry/*"],
      "fandryui/componentsData": ["src/modules/fandryui/componentsData/componentsData"],
      "fandryui/demoCard": ["src/modules/fandryui/demoCard/demoCard"],
      "fandryui/demoDivider": ["src/modules/fandryui/demoDivider/demoDivider"],
      "fandryui/demoPagination": ["src/modules/fandryui/demoPagination/demoPagination"],
      "fandryui/demoSidebar": ["src/modules/fandryui/demoSidebar/demoSidebar"],
      "fandryui/demoSidebarItem": ["src/modules/fandryui/demoSidebarItem/demoSidebarItem"],
      "fandryui/demoHeading": ["src/modules/fandryui/demoHeading/demoHeading"],
      "fandryui/demoIcon": ["src/modules/fandryui/demoIcon/demoIcon"],
      "fandryui/demoLabel": ["src/modules/fandryui/demoLabel/demoLabel"],
      "fandryui/demoText": ["src/modules/fandryui/demoText/demoText"],
      "fandryui/demoButton": ["src/modules/fandryui/demoButton/demoButton"],
      "fandryui/demoCheckbox": ["src/modules/fandryui/demoCheckbox/demoCheckbox"],
      "fandryui/demoInput": ["src/modules/fandryui/demoInput/demoInput"],
      "fandryui/demoLink": ["src/modules/fandryui/demoLink/demoLink"],
      "fandryui/demoRadio": ["src/modules/fandryui/demoRadio/demoRadio"],
      "fandryui/demoRadioGroup": ["src/modules/fandryui/demoRadioGroup/demoRadioGroup"],
      "fandryui/demoSelect": ["src/modules/fandryui/demoSelect/demoSelect"],
      "fandryui/demoSwitch": ["src/modules/fandryui/demoSwitch/demoSwitch"],
      "fandryui/demoTextarea": ["src/modules/fandryui/demoTextarea/demoTextarea"],
      "fandryui/demoAlert": ["src/modules/fandryui/demoAlert/demoAlert"],
      "fandryui/demoBadge": ["src/modules/fandryui/demoBadge/demoBadge"],
      "fandryui/demoSkeleton": ["src/modules/fandryui/demoSkeleton/demoSkeleton"],
      "fandryui/demoSpinner": ["src/modules/fandryui/demoSpinner/demoSpinner"],
      "fandryui/demoToast": ["src/modules/fandryui/demoToast/demoToast"],
      "fandryui/demoToastViewport": ["src/modules/fandryui/demoToastViewport/demoToastViewport"],
      "fandryui/demoTooltip": ["src/modules/fandryui/demoTooltip/demoTooltip"],
      "fandryui/demoAvatar": ["src/modules/fandryui/demoAvatar/demoAvatar"],
      "fandryui/demoMenu": ["src/modules/fandryui/demoMenu/demoMenu"],
      "fandryui/demoMenuItem": ["src/modules/fandryui/demoMenuItem/demoMenuItem"],
      "fandryui/demoPopover": ["src/modules/fandryui/demoPopover/demoPopover"],
      "fandryui/demoTable": ["src/modules/fandryui/demoTable/demoTable"],
      "fandryui/*": ["src/modules/fandryui/*"]
    },
    "typeRoots": ["./node_modules/@types", "./src/types"]
  },
  "include": ["src/**/*", "src/types/**/*", "src/types"],
  "exclude": ["node_modules", "__lwr_cache__", "site"]
}
